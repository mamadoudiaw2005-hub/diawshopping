# ─────────────────────────────────────────────────────────────────
# DIAW SHOOP — Exemple de variables d'environnement (.env.example)
# Copiez ce fichier en tant que ".env" sur votre machine locale ou
# ajoutez ces variables dans les paramètres "Environment Variables" de Vercel.
# ─────────────────────────────────────────────────────────────────

# Clés de paiement CinetPay (si activation du paiement en ligne direct)
CINETPAY_API_KEY=votre_cle_api_cinetpay
CINETPAY_SITE_ID=votre_site_id_cinetpay

# Configuration du serveur Flask
FLASK_PORT=8080
FLASK_ENV=production

# Token secret interne pour sécuriser l'API
MOCK_SECRET_TOKEN=
